<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="212dp"
    android:layout_height="212dp"
    android:background="#000000"
    android:layout_gravity="center">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnChat1"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/button2"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/img1"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Обсуждения"
        android:textColor="#FFF"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/btnChat1"
        app:layout_constraintStart_toStartOf="@id/btnChat1"
        app:layout_constraintTop_toBottomOf="@id/btnChat1" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnChat2"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/button2"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/img2"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Обсуждения"
        android:textColor="#FFF"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/btnChat2"
        app:layout_constraintStart_toStartOf="@id/btnChat2"
        app:layout_constraintTop_toBottomOf="@id/btnChat2" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnFav"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="120dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/button2"
        android:padding="12dp"
        android:src="@drawable/img3"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Избранное"
        android:textColor="#FFF"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/btnFav"
        app:layout_constraintStart_toStartOf="@id/btnFav"
        app:layout_constraintTop_toBottomOf="@id/btnFav" />

</androidx.constraintlayout.widget.ConstraintLayout>